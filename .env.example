VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-side database writes (issue #3)
# The Supabase service-role key. SERVER-SIDE ONLY — used by the Express admin
# API (server/adminApi.js) to perform all database writes. It bypasses RLS, so
# it must NEVER use the VITE_ prefix (that would embed it in the public browser
# bundle). Find it in the Supabase dashboard: Project Settings > API >
# service_role secret. Until this is set, all admin write endpoints return 503.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional shared secret protecting the admin write API. SERVER-SIDE ONLY.
# When set, every /api/admin request must send a matching `x-admin-token`
# header; when unset (local dev), no auth check is performed.
# ADMIN_API_TOKEN=some-long-random-string

# AI Provider Configuration
# NOTE: These are server-side only (used by the Express proxy in server.js).
# They must NEVER use the VITE_ prefix, or Vite would embed them into the public browser bundle.
LATIMER_API_KEY=your-latimer-api-key
LATIMER_BASE_URL=https://api.latimer.ai/v1

PERPLEXITY_API_KEY=your-perplexity-api-key
PERPLEXITY_BASE_URL=https://api.perplexity.ai

DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com